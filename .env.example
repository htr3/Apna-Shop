# Environment variables for the Apna Shop backend (Spring Boot)
# These are set in the Render dashboard, NOT committed with real values.

# === Database (Neon) ===
# Neon dashboard > Connection Details > copy the connection string.
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@your-host.neon.tech/neondb?sslmode=require

# === JWT secret ===
# On Render this is auto-generated (generateValue). For local dev set any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# === CORS ===
# Comma-separated list of allowed frontend origins.
# Set this to your Vercel URL, e.g. https://apna-shop.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# === Schema management ===
# Use "update" for the FIRST deploy to create tables on a fresh Neon database,
# then switch back to "none" to keep the schema stable.
DDL_AUTO=none
