# Environment Variables for Shopkeeper Insights
# Copy this file to .env and fill in your actual values

# === Node Environment ===
NODE_ENV=production

# === Port Configuration (Google Cloud Run) ===
# Google Cloud Run sets this automatically to 8080
# Local development uses 3000
PORT=8080

# === Supabase Configuration ===
# Get this from your Supabase project settings > Database > Connection String
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@your_host.supabase.co:5432/postgres?sslmode=require

# === JWT Secret ===
# Used for session/token management
# Generate a random string for production
JWT_SECRET=your_jwt_secret_here_change_this

# === Optional: Twilio Configuration (for OTP via WhatsApp) ===
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# === Optional: Email Configuration ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# === Optional: Google Cloud Secrets Manager ===
# GOOGLE_CLOUD_PROJECT_ID=your-project-id

